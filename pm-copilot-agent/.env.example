# ---- Claude (the agent's model) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Granola (where meeting notes come from) ----
# Personal or workspace API key: Granola desktop → Settings → Connectors → API keys (Business/Enterprise plan)
GRANOLA_API_KEY=
# Optional: only read notes in this folder (fol_xxxxxxxxxxxxxx). Leave blank for every note the key can see.
GRANOLA_FOLDER_ID=
# Optional: only analyse notes whose title contains one of these words (comma-separated, case-insensitive)
GRANOLA_TITLE_FILTER=
# How far back the first sync looks, and how often to poll afterwards (0 = only on demand)
GRANOLA_LOOKBACK_DAYS=14
GRANOLA_SYNC_MINUTES=15

# ---- Jira (read open tickets for context; write approved suggestions) ----
JIRA_BASE_URL=https://projects-teams.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BA
JIRA_JQL=project = BA AND "client[dropdown]" != RDA AND status NOT IN (Done, Backlog) ORDER BY cf[10019] ASC
# Issue type for new tickets (10006 = 任务 / Task in the BA project)
JIRA_ISSUE_TYPE_ID=10006
# true = approvals are recorded and the exact Jira request is logged, but nothing is written to Jira
JIRA_DRY_RUN=true
# Nightly read sync from Jira (DayOne plan + portfolio tickets) at 24:00 Mon–Fri Singapore time. off = disable.
JIRA_SYNC=on
# Which tickets make up the DayOne plan
DAYONE_JQL=project = BA AND (parent = BA-2380 OR summary ~ "DayOne-NTPE") ORDER BY key ASC

# ---- Sign-in (the AI-factory Product Center) ----
# This agent stores no passwords and no accounts: it hands the username and password to the
# Product Center and then verifies its JWT by asking it. Add, disable and reset people THERE;
# here you only map its roles onto this dashboard's roles (Roles & Access page, or `npm run grant`).
# Origin only — /api/login and /api/me are appended. The default is the Product Center's own
# nginx on this VM's port 80, which a host process can reach without joining ai-factory-net.
PRODUCT_CENTER_URL=http://127.0.0.1
# How long a verified token is trusted before re-checking. Also how long someone keeps access
# here after being disabled there, so keep it short.
PRODUCT_CENTER_CACHE_SECONDS=60
# Shown on the sign-in screen so people know which account to use
PRODUCT_CENTER_LABEL=AI-factory Product Center

# ---- Server ----
PORT=8790
# Comma-separated origins allowed to call the API. The dashboard is served by this agent on the
# same origin, so the default below is wider than it needs to be: narrow it in production.
ALLOWED_ORIGINS=*
