# ---- Claude (the agent's model) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Granola (where meeting notes come from) ----
# Personal or workspace API key: Granola desktop → Settings → Connectors → API keys (Business/Enterprise plan)
GRANOLA_API_KEY=
# Optional: only read notes in this folder (fol_xxxxxxxxxxxxxx). Leave blank for every note the key can see.
GRANOLA_FOLDER_ID=
# Optional: only analyse notes whose title contains one of these words (comma-separated, case-insensitive)
GRANOLA_TITLE_FILTER=
# How far back the first sync looks, and how often to poll afterwards (0 = only on demand)
GRANOLA_LOOKBACK_DAYS=14
GRANOLA_SYNC_MINUTES=15

# ---- Jira (read open tickets for context; write approved suggestions) ----
JIRA_BASE_URL=https://projects-teams.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BA
JIRA_JQL=project = BA AND "client[dropdown]" != RDA AND status NOT IN (Done, Backlog) ORDER BY cf[10019] ASC
# Issue type for new tickets (10006 = 任务 / Task in the BA project)
JIRA_ISSUE_TYPE_ID=10006
# true = approvals are recorded and the exact Jira request is logged, but nothing is written to Jira
JIRA_DRY_RUN=true
# Nightly read sync from Jira (DayOne plan + portfolio tickets) at 24:00 Mon–Fri Singapore time. off = disable.
JIRA_SYNC=on
# Which tickets make up the DayOne plan
DAYONE_JQL=project = BA AND (parent = BA-2380 OR summary ~ "DayOne-NTPE") ORDER BY key ASC

# ---- Server ----
# Password for the first "admin" user (only used when no users exist yet; leave blank to get a random one in the log)
ADMIN_PASSWORD=
# Comma-separated emails that get their own Super Admin account on first start (recommended instead of a shared admin)
SEED_ADMINS=
PORT=8790
# Comma-separated origins allowed to call the API, e.g. http://34.177.94.143:8083 (use * while testing)
ALLOWED_ORIGINS=*
