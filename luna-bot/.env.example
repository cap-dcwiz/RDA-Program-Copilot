# Copy this file to .env and fill in your own values LOCALLY.
# Never paste real secrets into chat, commit them to git, or share this file.

# --- Bot Framework / Azure Bot registration ---
BOT_APP_ID=
BOT_APP_PASSWORD=
BOT_TENANT_ID=
# MultiTenant | SingleTenant | UserAssignedMSI
BOT_APP_TYPE=MultiTenant

# --- Server ---
PORT=3978

# --- Teams channel targets (conversation references) ---
# These are obtained once by adding the bot to each Team/channel and capturing
# the resulting conversation reference (see README "Getting channel IDs").
# They are NOT plain channel names — Teams requires a full conversation reference
# (serviceUrl + channelId + conversation.id) to send proactive messages.
TEAMS_CONTROL_ROOM_CONVERSATION_REF_PATH=./data/control-room-conversation-ref.json
TEAMS_PROJECT_GROUP_CONVERSATION_REF_PATH=./data/project-group-conversation-ref.json

# --- Delivery Control Room reviewers (must match the Teams AAD object id or UPN
# of the person clicking Approve/Edit/Reject, used to record Approval.approvedBy) ---
REVIEWER_1_NAME=Selena
REVIEWER_1_UPN=
REVIEWER_2_NAME=Sherry
REVIEWER_2_UPN=

# --- Business rule thresholds (Part 7 of the PRD) ---
REMINDER_THRESHOLD_HOURS=48
ESCALATION_THRESHOLD_DAYS=7
ESCALATION_MIN_REMINDERS=2
