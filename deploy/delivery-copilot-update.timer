# Auto-deploy check, every ten minutes: a merge to main reaches the site within ten minutes
# instead of waiting for the small hours. A run that finds nothing is a fetch and a sha compare —
# 0.55s measured on this VM — and flock in the script means a slow deploy is never overlapped.
#
# This used to run once a day at 19:30 UTC, chosen to sit clear of the agent's own nightly Jira
# sync at 16:00 UTC. Ten-minute checks give that up, so the script honours the sync window itself
# and defers to the next tick.
#
# Install: systemctl enable --now delivery-copilot-update.timer
# Inspect: systemctl list-timers delivery-copilot-update
[Unit]
Description=Check for new Delivery Copilot commits on main (every 10 minutes)

[Timer]
OnCalendar=*:0/10
# Jitter, so this never lands on the exact minute every other cron-shaped thing on the box uses.
RandomizedDelaySec=2min
# If the VM was off over a tick, run once it is back rather than waiting for the next one.
Persistent=true
Unit=delivery-copilot-update.service

[Install]
WantedBy=timers.target
